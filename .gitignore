# Cloned upstream repositories (~2.5 GB). Read-only inputs, reproducible with
#   git clone --depth 1 https://github.com/storytold/<repo>.git
# The full list, with what each one is, is in docs/CRAFT-MATRIX.md.
repos/

# Downloaded craft CLIs and release archives (~3.6 GB), reproducible from the
# official GitHub releases with scripts/fetch-binaries.mjs.
bin/
crafts-bin/

# Verification scratch space
.verify/

# Local credentials — never commit a token
*.token
github_token*.txt
.env
.env.*

# Node dependencies, recreated by scripts/install-links.mjs
node_modules/

# Package tarballs, from scripts/install-into-profile.mjs or `pnpm pack`
*.tgz

# A craft writing a project into the working directory would land here
/ARTIFACT
*.pcraft
/*.png

# Editor and OS noise
.DS_Store

# Per-machine binary paths; discovery falls back to env vars and PATH without it.
dsh-plugins/craft-kit/catalog/binaries.json

# Local capture material, historical screenshots, and CI files stay out of the
# repository by decision: the audio is not a shipping asset, the screenshots are
# superseded, and the workflows wait for a token with the workflow scope.
/.github/
/Audio Files/
/voice_raw.wav
/deepseek_harness_greeting.scraft
/docs/screenshots/
/scripts/download-crafts-parallel.mjs
/scripts/push-via-api.mjs
