{
  "name": "@dsh-artcraft/craft-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared kernel for the ArtCraft DSH plugins: craft binary discovery, headless CLI invocation, command-catalog loading and tool construction.",
  "license": "MIT OR Apache-2.0",
  "exports": {
    ".": "./lib/index.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "files": [
    "lib",
    "src",
    "catalog",
    "package.json"
  ],
  "main": "lib/index.js",
  "scripts": {
    "build": "node ../../scripts/build-kit.mjs"
  }
}
