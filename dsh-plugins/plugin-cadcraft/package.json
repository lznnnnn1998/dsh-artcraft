{
  "name": "dsh-artcraft-plugin-cadcraft",
  "version": "0.2.12",
  "private": false,
  "type": "module",
  "description": "DSH plugin: drive CADCraft (CAD and drafting) headlessly through its own CLI and MCP server.",
  "license": "MIT OR Apache-2.0",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "files": [
    "src",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "cordis",
    "artcraft",
    "cadcraft",
    "ai-agent",
    "mcp"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": "^0.2.1-rc.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lznnnnn1998/dsh-artcraft.git",
    "directory": "dsh-plugins/plugin-cadcraft"
  },
  "homepage": "https://github.com/lznnnnn1998/dsh-artcraft/tree/main/dsh-plugins/plugin-cadcraft"
}
