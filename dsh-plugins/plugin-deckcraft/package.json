{
  "name": "dsh-artcraft-plugin-deckcraft",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "DSH plugin: drive DeckCraft (presentations) headlessly through its own CLI and MCP server.",
  "license": "MIT OR Apache-2.0",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "cordis",
    "artcraft",
    "deckcraft",
    "ai-agent",
    "mcp"
  ],
  "publishConfig": {
    "access": "public"
  }
}
